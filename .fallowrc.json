{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

	// Analyse only code ghspace owns. Without these, the vendored Oxlint plugin
	// dominates every report — it accounted for most health hotspots and four of
	// five clone groups on the first run — and the findings would be pressure to
	// edit third-party files we deliberately track against an upstream revision.
	"ignorePatterns": [
		"tools/oxlint/anti-slop/**",
		".claude/**",
		"**/.source/**",
		"**/.next/**",
		"**/drizzle/**"
	],

	// Consequence of the ignore above, not genuinely unused: the only importer of
	// @oxlint/plugins is the vendored plugin, which fallow no longer reads. Drop
	// this entry if that tree ever stops being ignored.
	"ignoreDependencies": ["@oxlint/plugins"],

	// Names must match fallow's own vocabulary exactly — an unknown key is
	// warned about and then ignored, which would read as an enabled rule that
	// silently never fires. Verify with: fallow dead-code 2>&1 | grep 'unknown rule'
	"rules": {
		"unused-files": "error",
		"unused-exports": "error",
		"unused-types": "error",
		"unused-dependencies": "error",
		"unused-dev-dependencies": "error",
		"unresolved-imports": "error",
		"circular-dependencies": "error",
		"re-export-cycles": "error"
	}
}
