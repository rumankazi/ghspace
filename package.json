{
  "name": "ghspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "db:down": "./scripts/dev-db.sh down",
    "db:generate": "bun run --filter @ghspace/core db:generate",
    "db:migrate": "bun run --filter @ghspace/core db:migrate",
    "db:reset": "./scripts/dev-db.sh reset",
    "db:studio": "bun run --filter @ghspace/core db:studio",
    "db:up": "./scripts/dev-db.sh up",
    "deadcode": "fallow dead-code --fail-on-issues",
    "dev": "bun run --filter '*' dev",
    "dev:docs": "bun run --filter @ghspace/docs dev",
    "dev:web": "bun run --filter @ghspace/web dev",
    "dev:worker": "bun run --filter @ghspace/worker dev",
    "doctor": "bun run --env-file=.env scripts/doctor.ts",
    "dupes": "fallow dupes --fail-on-issues",
    "badge": "fallow health --format badge > .github/badges/fallow-health.svg",
    "health": "fallow health",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "map": "bun run --filter @ghspace/docs map",
    "seed": "bun run --filter @ghspace/core seed",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "fallow": "3.27.0",
    "oxlint": "1.83.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "pg": "^8.16.3"
  }
}
