# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any Postgres. ghspace uses nothing but the connection string, so a managed
# host (Supabase, Neon, RDS) and a self-hosted container are interchangeable.
#
#   local docker/podman   postgres://ghspace:ghspace@localhost:5433/ghspace
#   supabase (direct)     postgres://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
#   supabase (pooler)     postgres://postgres.PROJECT:PASS@REGION.pooler.supabase.com:6543/postgres
#
# Use the pooler (port 6543, transaction mode) for serverless deployments only;
# a long-running process should connect directly.
DATABASE_URL=postgres://ghspace:ghspace@localhost:5433/ghspace

# Postgres pool size. 10 suits a long-running process. Set to 1 on serverless,
# where every function instance opens its own pool and they multiply.
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Rotating this invalidates every stored GitHub token; users must re-authorise.
ENCRYPTION_KEY=

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# Create at https://github.com/settings/apps/new with:
#   - "Request user authorization (OAuth) during installation" ENABLED
#   - "Expire user authorization tokens" ENABLED
#   - Callback URL: http://localhost:3000/api/auth/callback
# The app's URL slug, from github.com/settings/apps/<slug>. Used to build the
# "install on another organization" link.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The app's private key. Download the .pem from the app settings, then:
#   base64 -i your-app.private-key.pem | tr -d '\n'
# A raw PEM is also accepted, but cannot be written on one line.
GITHUB_APP_PRIVATE_KEY=

# Override both for GitHub Enterprise Server.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=120
LOG_LEVEL=info

# Log rendering. Defaults to a readable line on a terminal and single-line JSON
# when piped or redirected. Force it with "pretty" or "json".
# LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# Development-only sign-in using seeded data (bun run seed). Never set in production.
# ALLOW_DEV_LOGIN=1
