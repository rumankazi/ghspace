# Generated by `next dev`, `next build` and `next typegen`. Next.js calls its
# contents an implementation detail and asks for it to be untracked, and it is:
# the file points at .next/types when a build ran last and .next/dev/types when
# dev did, so a tracked copy flips back and forth with whichever command a
# developer happened to run. `bun run typecheck` regenerates it first.
apps/web/next-env.d.ts

.env
.env.local
.env.*.local
!.env.example

